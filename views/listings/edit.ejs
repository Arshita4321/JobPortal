<% layout("/layouts/boilerplate")%>
<body>
    <div class="row mt-4">
        <div class="col-8 offset-2">
    <h3>Edit this Job Profile</h3>
    <form method="POST" action ="/listings/<%= listing._id%>?_method=PUT" novalidate class="needs-validation">
        <div class="mb-3">  
            <label for="title" class="form-label"> Title </label>
            <input name="Listing[title]" value="<%= listing.title%>" type = "text" class="form-control" required>
            <div class="invalid-feedback">Please enter a title</div>
        </div>

        <div class="mb-3">  
            <label for="description" class="form-label"> Description </label>
            <textarea name="Listing[description]" class="form-control" > <%= listing.description%></textarea>
            <div class="invalid-feedback">Please enter a short description</div>
        </div>

        <div class="mb-3">  
            <label for="image" class="form-label"> Image </label>
            <input name="Listing[image][url]" value="<%= listing.image.url%>" type = "text" class="form-control">
            <div class="invalid-feedback">Please enter image url</div>
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">  
                <label for="salary" class="form-label"> Salary </label>
                <input name="Listing[salary]" value="<%= listing.salary%>" type = "text" class="form-control" required>
                <div class="invalid-feedback">Please enter a salary</div>
            </div>
    
            <div class="mb-3 col-md-8">  
                <label for="location" class="form-label"> location </label>
                <input name="Listing[location]" value="<%= listing.location%>" type = "text" class="form-control" required>
                <div class="invalid-feedback">Please enter a location</div>
            </div>
        </div>
        

        <div class="mb-3">  
            <label for="type" class="form-label"> Job Type </label>
            <input name="Listing[type]" value="<%= listing.type %>" type = "text" class="form-control" required>
            <div class="invalid-feedback">Please enter job type</div>
        </div>

        <button class="btn btn-dark edit-btn mt-3 ">Edit</button>

    </form>
</div>
</div>
</body>
<script src="/js/script.js"></script>
