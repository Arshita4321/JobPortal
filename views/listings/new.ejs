<% layout("/layouts/boilerplate")%>
<body>
    <div class="row mt-4">
        <div class="col-8 offset-2">  
    <h3>Add New Job</h3>
    <form method="POST" action ="/listings" novalidate class="needs-validation">
        <div class="mb-3">
            <label for="title" class="form-label"> Title </label>
            <input name="Listing[title]" placeholder="title of job" type = "text" class="form-control" required>

            <div class="valid-feedback">Title looks good</div>
            <div class="invalid-feedback">Please enter title</div>
        </div>

        <div class="mb-3"> 
         <label for="description" class="form-label" > Description </label>
         <textarea name="Listing[description]" placeholder="description of job" class="form-control" required></textarea>
        <div class="invalid-feedback">Please enter a short description</div>
        </div>

        <div class="mb-3">
        <label for="image" class="form-label"> Image </label>
        <input name="Listing[image][url]" placeholder="enter image URL/Link" type = "text" class="form-control" required>
        <div class="invalid-feedback">Please enter image url</div>
        <div class="invalid-feedback">Please enter title</div>
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">  
                <label for="salary" class="form-label"> Salary </label>
                <input name="Listing[salary]" placeholder="&#8377; 67000" type = "text" class="form-control" required>
                <div class="invalid-feedback">Please enter valid salary</div>
            </div>

            <div class="mb-3 col-md-8"> 
                <label for="location" class="form-label"> Location </label>
                <input name="Listing[location]" placeholder="India" type = "text" class="form-control" required>
                <div class="invalid-feedback">Please enter location</div>
            </div>
        </div>
        

        <div class="mb-3"> 
        <label for="type" class="form-label"> Type </label>
        <input name="Listing[type]" placeholder="part-time/full-time" type = "text" class="form-control">
        <div class="invalid-feedback">Please enter type of job</div>
        </div>

        <button class="btn btn-dark add-btn mt-3">Add</button>
        
    </form>  
    </div>
    </div>
</body>
